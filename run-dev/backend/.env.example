# Server-only settings for the setup script (and Functions later). Never ship these to the browser.
# The endpoint and project ID are read from ../frontend/.env.local, so they aren't repeated here.

# API key with the scopes listed in README → "API key".
APPWRITE_API_KEY=
# Hostname the web app runs on; setup registers it as a Web platform.
APP_HOSTNAME=localhost

# The one admin. Setup creates this user if missing and gives it the `admin` label.
ADMIN_EMAIL=
ADMIN_NAME=Board Admin
# Optional. Adds email + password sign-in for the admin (min 10 characters).
ADMIN_PASSWORD=

# Optional seeded demo reader.
DEMO_USER_EMAIL=
DEMO_USER_NAME=Demo Reader
DEMO_USER_PASSWORD=

# Google sign-in (optional). `npm run setup:google` hands these to Appwrite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
