# Browser settings. Everything here ends up in the client bundle, so no secrets.
# Server-only values (API key, admin password, Google secret) live in ../backend/.env.local.

# Appwrite API endpoint, including /v1 (Cloud: https://<region>.cloud.appwrite.io/v1).
NEXT_PUBLIC_APPWRITE_ENDPOINT=
# Project ID from the Appwrite console (Settings → Overview).
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Optional. Prefix for table ids, e.g. "test_" to run tests against test_board etc.
# NEXT_PUBLIC_APPWRITE_TABLE_PREFIX=
